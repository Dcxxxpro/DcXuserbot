# ══════════════════════════════════════════════════════════════════
#  DcXuserbot v5 — environment configuration
#  Copy to `.env` (or export these vars) and fill in your values.
# ══════════════════════════════════════════════════════════════════

# ── REQUIRED · Telegram API creds (https://my.telegram.org) ──────────
API_ID=12345678
API_HASH=your_api_hash_here

# User session string → generate with:  python -m dcx.session_string
STRING_SESSION=your_telethon_string_session_here

# ── INLINE MODE · BotFather assistant (enables every command inline) ─
# 1) Create a bot with @BotFather
# 2) /setinline → "Manage DcXuserbot inline"
# 3) Paste the token + username below
BOT_TOKEN=7123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=DcXAssistantBot

# ── COMMAND CONTROL ──────────────────────────────────────────────────
COMMAND_HAND_LER=.
SUDO_COMMAND_HAND_LER=!
SUDO_USERS=                          # comma-separated user IDs

# ── BRANDING ─────────────────────────────────────────────────────────
ALIVE_NAME=DcX Master
ALIVE_MEDIA=https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1200
HELP_MEDIA=                          # falls back to ALIVE_MEDIA when empty

# ── AI ENGINES (optional) ────────────────────────────────────────────
GROQ_API_KEY=                        # console.groq.com → lightning Llama
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=                      # aistudio.google.com
GEMINI_MODEL=gemini-2.0-flash

# ── PM PERMIT SHIELD ─────────────────────────────────────────────────
PM_PERMIT=true
PM_LIMIT=4

# ── HOUSEKEEPING ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
DCX_DATA_DIR=                        # default: repo/data (sessions, state, cache)
